<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

    <!--
        Cerid Engine - Visual Studio Debug Visualizers
        Add entries here as we create custom types.
    -->

    <Type Name="crd::math::Vec2&lt;*&gt;">
        <DisplayString>({x}, {y})</DisplayString>
        <Expand>
            <Item Name="x">x</Item>
            <Item Name="y">y</Item>
        </Expand>
    </Type>

    <Type Name="crd::math::Vec3&lt;*&gt;">
        <DisplayString>({x}, {y}, {z})</DisplayString>
        <Expand>
            <Item Name="x">x</Item>
            <Item Name="y">y</Item>
            <Item Name="z">z</Item>
        </Expand>
    </Type>

    <Type Name="crd::math::Vec4&lt;*&gt;">
        <DisplayString>({x}, {y}, {z}, {w})</DisplayString>
        <Expand>
            <Item Name="x">x</Item>
            <Item Name="y">y</Item>
            <Item Name="z">z</Item>
            <Item Name="w">w</Item>
        </Expand>
    </Type>

    <Type Name="crd::math::Quat&lt;*&gt;">
        <DisplayString>xyzw=({x}, {y}, {z}, {w})</DisplayString>
        <Expand>
            <Item Name="x">x</Item>
            <Item Name="y">y</Item>
            <Item Name="z">z</Item>
            <Item Name="w">w</Item>
        </Expand>
    </Type>

    <Type Name="crd::math::Mat2&lt;*&gt;">
        <DisplayString>[[{c0.x}, {c1.x}], [{c0.y}, {c1.y}]]</DisplayString>
        <Expand>
            <Item Name="col0">c0</Item>
            <Item Name="col1">c1</Item>
        </Expand>
    </Type>

    <Type Name="crd::math::Mat3&lt;*&gt;">
        <DisplayString>[[{c0.x}, {c1.x}, {c2.x}], [{c0.y}, {c1.y}, {c2.y}], [{c0.z}, {c1.z}, {c2.z}]]</DisplayString>
        <Expand>
            <Item Name="col0">c0</Item>
            <Item Name="col1">c1</Item>
            <Item Name="col2">c2</Item>
        </Expand>
    </Type>

    <Type Name="crd::math::Mat4&lt;*&gt;">
        <DisplayString>[[{c0.x}, {c1.x}, {c2.x}, {c3.x}], [{c0.y}, {c1.y}, {c2.y}, {c3.y}], [{c0.z}, {c1.z}, {c2.z}, {c3.z}], [{c0.w}, {c1.w}, {c2.w}, {c3.w}]]</DisplayString>
        <Expand>
            <Item Name="col0">c0</Item>
            <Item Name="col1">c1</Item>
            <Item Name="col2">c2</Item>
            <Item Name="col3">c3</Item>
        </Expand>
    </Type>

    <Type Name="crd::math::Transform&lt;*&gt;">
        <DisplayString>t=({translation.x}, {translation.y}, {translation.z}) r=({rotation.x}, {rotation.y}, {rotation.z}, {rotation.w})</DisplayString>
        <Expand>
            <Item Name="translation">translation</Item>
            <Item Name="rotation">rotation</Item>
        </Expand>
    </Type>

    <Type Name="crd::math::Ray&lt;*&gt;">
        <DisplayString>o=({origin.x}, {origin.y}, {origin.z}) d=({direction.x}, {direction.y}, {direction.z})</DisplayString>
        <Expand>
            <Item Name="origin">origin</Item>
            <Item Name="direction">direction</Item>
        </Expand>
    </Type>

    <Type Name="crd::math::Plane&lt;*&gt;">
        <DisplayString>n=({normal.x}, {normal.y}, {normal.z}) d={d}</DisplayString>
        <Expand>
            <Item Name="normal">normal</Item>
            <Item Name="d">d</Item>
        </Expand>
    </Type>

    <Type Name="crd::math::Sphere&lt;*&gt;">
        <DisplayString>c=({center.x}, {center.y}, {center.z}) r={radius}</DisplayString>
        <Expand>
            <Item Name="center">center</Item>
            <Item Name="radius">radius</Item>
        </Expand>
    </Type>

    <Type Name="crd::math::AABB&lt;*&gt;">
        <DisplayString>min=({min.x}, {min.y}, {min.z}) max=({max.x}, {max.y}, {max.z})</DisplayString>
        <Expand>
            <Item Name="min">min</Item>
            <Item Name="max">max</Item>
        </Expand>
    </Type>

    <Type Name="crd::math::Triangle&lt;*&gt;">
        <DisplayString>a=({a.x}, {a.y}, {a.z}) b=({b.x}, {b.y}, {b.z}) c=({c.x}, {c.y}, {c.z})</DisplayString>
        <Expand>
            <Item Name="a">a</Item>
            <Item Name="b">b</Item>
            <Item Name="c">c</Item>
        </Expand>
    </Type>

    <Type Name="crd::math::Frustum&lt;*&gt;">
        <DisplayString>planes[6]</DisplayString>
        <Expand>
            <Item Name="left">planes[0]</Item>
            <Item Name="right">planes[1]</Item>
            <Item Name="bottom">planes[2]</Item>
            <Item Name="top">planes[3]</Item>
            <Item Name="near">planes[4]</Item>
            <Item Name="far">planes[5]</Item>
        </Expand>
    </Type>

    <!-- Example: when we build our dynamic array later
    <Type Name="crd::Array&lt;*&gt;">
        <DisplayString>{{ size={m_size} }}</DisplayString>
        <Expand>
            <ArrayItems>
                <Size>m_size</Size>
                <ValuePointer>m_data</ValuePointer>
            </ArrayItems>
        </Expand>
    </Type>
    -->

</AutoVisualizer>
