{
  "format": "cerid-wire-schema/1",
  "name": "session_control",
  "about": "The control channel every Cerid session opens: the revision each side writes, capability and revocation renewal, generation handshakes, state hashes, the baselines each side holds and going away. It runs below S18: no capability can authorize presenting a capability.",
  "id": "c3a17e4f0b8d4d6a9e52f1a6d07b3c18",
  "kind": "transport",
  "revision": {"major": 1, "minor": 1},
  "history": {
    "0": "5efb9b989e1500c86800c8b19e235c297594231fad43debe9e3ad78fed0761e4",
    "1": "3a22c128475c5ceeb429e3dd972430cca892e872c71ea46afc6129d3b29a5dd7"
  },
  "channels": [
    {
      "name": "control",
      "class": "Control",
      "reliable": true,
      "ordered": true,
      "priority": 0,
      "max_message_bytes": 170000,
      "messages_per_s": 64,
      "bytes_per_s": 262144
    }
  ],
  "enums": {
    "GoAwayReason": {
      "bits": 4,
      "values": [
        {"name": "Done", "value": 0},
        {"name": "Overloaded", "value": 1},
        {"name": "Maintenance", "value": 2},
        {"name": "Banned", "value": 3},
        {"name": "PolicyRefused", "value": 4},
        {"name": "RevisionRefused", "value": 5},
        {"name": "ProtocolError", "value": 6}
      ]
    }
  },
  "messages": [
    {
      "name": "RevisionAnnounce",
      "id": 1,
      "channel": "control",
      "fields": [
        {"name": "schema", "type": "bytes", "size": 16},
        {"name": "schema_major", "type": "uint", "bits": 16},
        {"name": "writer_minor", "type": "uint", "bits": 16}
      ]
    },
    {
      "name": "SchemaPresent",
      "id": 2,
      "channel": "control",
      "fields": [
        {"name": "artefact", "type": "bytes", "max": 34816}
      ]
    },
    {
      "name": "CapabilityPresent",
      "id": 3,
      "channel": "control",
      "fields": [
        {"name": "token", "type": "bytes", "max": 49152},
        {"name": "proof", "type": "bytes", "max": 16384, "optional": true}
      ]
    },
    {
      "name": "RevocationsPresent",
      "id": 4,
      "channel": "control",
      "fields": [
        {"name": "generation", "type": "bytes", "max": 163840}
      ]
    },
    {
      "name": "GenerationAnnounce",
      "id": 5,
      "channel": "control",
      "fields": [
        {"name": "policy_generation", "type": "varuint", "max": 18446744073709551615},
        {"name": "revocation_generation", "type": "varuint", "max": 18446744073709551615},
        {"name": "rule_generation", "type": "varuint", "max": 18446744073709551615}
      ]
    },
    {
      "name": "StateHash",
      "id": 6,
      "channel": "control",
      "fields": [
        {"name": "step", "type": "varuint", "max": 18446744073709551615},
        {"name": "hash", "type": "uint", "bits": 64},
        {"name": "chain", "type": "uint", "bits": 64}
      ]
    },
    {
      "name": "GoAway",
      "id": 7,
      "channel": "control",
      "fields": [
        {"name": "reason", "type": "GoAwayReason"},
        {"name": "retry_after_ms", "type": "varuint", "max": 86400000, "group": 8},
        {"name": "detail", "type": "text", "max": 256}
      ]
    },
    {
      "name": "BaselineAck",
      "id": 8,
      "channel": "control",
      "since": 1,
      "fields": [
        {"name": "channel", "type": "varuint", "max": 4294967295},
        {"name": "message", "type": "varuint", "max": 1073741823},
        {"name": "object", "type": "varuint", "max": 18446744073709551615},
        {"name": "sequence", "type": "uint", "bits": 16}
      ]
    }
  ]
}
