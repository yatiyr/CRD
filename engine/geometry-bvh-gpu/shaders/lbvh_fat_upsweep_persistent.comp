#version 450

// ---------------------------------------------------------------------------
// LBVH fat-node upsweep — PERSISTENT-THREADS variant.
// Phase 3.1.7 v9a-c-persistent-threads (2026-05-18).
//
// Fewer total threads than leaves, each thread loops pulling work from a
// global atomic counter. Trades thread parallelism for reduced launch
// overhead + better instruction-cache hit rate. The dispatch grid is sized
// to ~oversubscribe the GPU (SM count × wave-size × small factor) rather
// than launching one thread per leaf.
//
// Per Apetrei 2014 / "Persistent Threads" idiom for irregular workloads:
// - Random unit-cube inputs make leaf walks irregular (different depths)
// - Standard 1-thread-per-leaf launch wastes cycles on early-exit warps
// - Persistent threads keep SMs warm with whatever work is left in queue
//
// **Algorithm is identical to lbvh_fat_upsweep.comp** — the carry-register
// walk semantics are unchanged. Only the SCHEDULING differs (atomic queue
// vs flat-launch).
// ---------------------------------------------------------------------------

#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) coherent buffer Nodes { uint nodes[]; }                  nodes_buf;
layout(set = 0, binding = 1) readonly buffer InLeafParents { uint leaf_parents[]; }   in_leaf_parents;
layout(set = 0, binding = 2) coherent buffer ChildrenDone { uint children_done[]; }   done_buf;
layout(set = 0, binding = 3) readonly buffer InSortedPairs { uint pairs[]; }          in_sorted_pairs;
layout(set = 0, binding = 4) readonly buffer InLeafAabbs { float aabbs[]; }           in_leaf_aabbs;
layout(set = 0, binding = 5) coherent buffer WorkQueue { uint counter; }              work_queue;

layout(push_constant) uniform Push { uint n; } pc;

const uint kRightBit  = 0x80000000u;
const uint kIndexMask = 0x7FFFFFFFu;

uint load_parent_idx(uint internal_idx) { return nodes_buf.nodes[internal_idx * 16u + 0u]; }

void store_slot(uint parent_internal, uint slot, vec3 lo, vec3 hi)
{
    uint base = parent_internal * 16u + 4u + slot * 6u;
    nodes_buf.nodes[base + 0u] = floatBitsToUint(lo.x);
    nodes_buf.nodes[base + 1u] = floatBitsToUint(lo.y);
    nodes_buf.nodes[base + 2u] = floatBitsToUint(lo.z);
    nodes_buf.nodes[base + 3u] = floatBitsToUint(hi.x);
    nodes_buf.nodes[base + 4u] = floatBitsToUint(hi.y);
    nodes_buf.nodes[base + 5u] = floatBitsToUint(hi.z);
}

void load_slot(uint parent_internal, uint slot, out vec3 lo, out vec3 hi)
{
    uint base = parent_internal * 16u + 4u + slot * 6u;
    lo = vec3(uintBitsToFloat(nodes_buf.nodes[base + 0u]),
              uintBitsToFloat(nodes_buf.nodes[base + 1u]),
              uintBitsToFloat(nodes_buf.nodes[base + 2u]));
    hi = vec3(uintBitsToFloat(nodes_buf.nodes[base + 3u]),
              uintBitsToFloat(nodes_buf.nodes[base + 4u]),
              uintBitsToFloat(nodes_buf.nodes[base + 5u]));
}

void walk_one_leaf(uint k)
{
    uint prim_idx = in_sorted_pairs.pairs[2u * k + 1u];
    uint a_base   = prim_idx * 6u;
    vec3 carried_lo = vec3(in_leaf_aabbs.aabbs[a_base + 0u],
                            in_leaf_aabbs.aabbs[a_base + 1u],
                            in_leaf_aabbs.aabbs[a_base + 2u]);
    vec3 carried_hi = vec3(in_leaf_aabbs.aabbs[a_base + 3u],
                            in_leaf_aabbs.aabbs[a_base + 4u],
                            in_leaf_aabbs.aabbs[a_base + 5u]);

    uint pkt        = in_leaf_parents.leaf_parents[k];
    uint parent     = pkt & kIndexMask;
    uint is_right   = (pkt & kRightBit) >> 31u;

    while (true)
    {
        store_slot(parent, is_right, carried_lo, carried_hi);

        uint prior = atomicAdd(done_buf.children_done[parent], 1u);
        if (prior == 0u) { return; }

        vec3 sib_lo, sib_hi;
        load_slot(parent, 1u - is_right, sib_lo, sib_hi);
        carried_lo = min(carried_lo, sib_lo);
        carried_hi = max(carried_hi, sib_hi);

        uint p_pkt = load_parent_idx(parent);
        if (p_pkt == 0xFFFFFFFFu) { return; }
        parent   = p_pkt & kIndexMask;
        is_right = (p_pkt & kRightBit) >> 31u;
    }
}

void main()
{
    // Persistent-threads loop with WARP-BATCHED atomic pulls. One atomic per
    // warp (32 threads) instead of per thread reduces counter contention by
    // 32×. Each warp pulls a contiguous chunk of `subgroupSize` leaves;
    // each lane processes one leaf from the chunk.
    while (true)
    {
        uint base = 0u;
        if (subgroupElect())                                    // one lane per subgroup
        {
            base = atomicAdd(work_queue.counter, gl_SubgroupSize);
        }
        base = subgroupBroadcastFirst(base);
        uint k = base + gl_SubgroupInvocationID;
        if (base >= pc.n) { return; }                           // whole warp done
        if (k < pc.n) { walk_one_leaf(k); }                     // partial-final-warp tail
    }
}
