# Generated builds, dependencies and scratch work. See docs/design/repository-layout.md.
/build/
/out/
/cmake-build-*/
/_deps/
/.cpm-cache/
/.sccache/
/external/
CMakeFiles/
CMakeCache.txt
compile_commands.json
CMakeUserPresets.json
/Testing/

# IDE/user state. Shared .vscode settings and agent entry documents ARE source.
.vs/
*.suo
*.user
*.VC.db
*.VC.db-shm
*.VC.db-wal
*.VC.VC.opendb
*.opensdf
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Compiler, linker, coverage and profiler output.
*.obj
*.o
*.lib
*.a
*.exe
*.dll
*.so
*.so.*
*.dylib
*.pdb
*.ilk
*.exp
*.pch
*.ipch
*.gcda
*.gcno
*.profraw
*.profdata
cachegrind.out.*
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/

# Local tool state and secrets. AGENTS/CLAUDE/context/MEMORY remain versioned.
/.claude/
/.codex/
.env
.env.local
.env.*.local

# Captured runs and cooked caches belong under build/ or OS temporary storage.
*.log
*_stdout.txt
*_stderr.txt
/crashes/
/review-bundle/
/.crd_*/
/imgui.ini
/assets/cooked/
/test_pack_*.crdr
/test_cook_*.tga
/test_cook_*.glb
/sr_*.crdr
/ev_stream_*.crdr
/scratch_*.txt
/asan_err.txt
/PATH-backup-*
/scripts/.full-sweep-win-tmp.*

# Downloaded research papers stay outside Git; cite primary sources in research Markdown.
/docs/research/papers/
*.pdf
