{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/cerid-coder",
  "small_model": "ollama/cerid-coder",
  "default_agent": "planner",
  "share": "disabled",
  "snapshot": true,
  "autoupdate": true,

  "provider": {
    "ollama": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000
      }
    }
  },

  "permission": {
    "*": "allow",
    "edit": {
      "*": "allow"
    },
    "bash": {
      "*": "allow",
      "git push *": "deny",
      "git push": "deny",
      "git commit *": "deny",
      "git commit": "deny",
      "rm -rf *": "deny",
      "Remove-Item -Recurse -Force *": "ask"
    },
    "external_directory": "deny",
    "doom_loop": "ask"
  },

  "mcp": {
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "mcp-searxng"],
      "enabled": true,
      "environment": {
        "SEARXNG_URL": "http://localhost:8080"
      },
      "timeout": 15000
    }
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8000
  },

  "watcher": {
    "ignore": [
      "build/**",
      "out/**",
      ".git/**",
      "node_modules/**",
      "docs/sessions/**"
    ]
  }
}
