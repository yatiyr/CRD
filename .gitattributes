# Let git auto-detect text files
* text=auto

# Source code - always store as LF in the repo
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.cmake text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.toml text eol=lf
*.ckir text eol=lf
*.ceir text eol=lf
*.chir text eol=lf
*.chirgraph text eol=lf

# Config / docs
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Windows-specific files can stay CRLF
*.natvis text eol=crlf
*.bat text eol=crlf
*.sln text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.spv binary
*.ttf binary

# Fuzz corpora are raw bytes: never normalized, never merged as text
tests/**/fuzz/corpus/** -text -diff -merge
tests/**/fuzz/pending/** -text -diff -merge
