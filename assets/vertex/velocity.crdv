schema = 1
name   = "crd://vertex/velocity"

# ⭐⭐ REN-41 (velocity, path A): a MATCHED velocity vertex program — CLIP-IDENTICAL to crd://vertex/scene (same
# instance transform + view_proj, so it produces the same depth and shares the prepass), but it emits ONLY the two
# clip interpolants the velocity FS forms the motion vector from (previous + current), not the forward's shading
# varyings. Non-skinned groups (the static grid, the spinning monuments). The `prev:clip` term reads the
# per-instance previous transform from header word 107 (kHdrPrevWorldOff) and projects by the CURRENT view_proj,
# so the TAA jitter cancels and a static instance yields a zero motion vector.
[header]
index_count    = 0
index_off      = 2
vertex_off     = 3
instance_off   = 4
visible_off    = 5
view_proj      = 6
light_vp       = 32
prev_world_off = 107
instance_count = 100

[vertex]
stride = 12

[[attribute]]
name   = "position"
offset = 0
comps  = 3
kind   = "position"

[instance]
stride    = 20
transform = 0

[[varying]]
name     = "prev_clip"
location = 5
interp   = "smooth"
source   = ["prev:clip"]

[[varying]]
name     = "cur_clip"
location = 6
interp   = "smooth"
source   = ["clip"]
