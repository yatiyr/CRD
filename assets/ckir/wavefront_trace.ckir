# wavefront_trace.ckir - CEIR-19c STAGE 2 (the WAVEFRONT): the PRIMARY-ray TRACE kernel. One thread per ray inline-ray-queries
# the REAL TLAS and writes hit_flag (U32: 1 hit / 0 miss, derived from TraceRayHit's prim sentinel — the DECISION int the
# serial compact consumes) + hit_t (F32 distance, for the shade kernel's o+t*d hit-position re-derivation). AUTHORED (mandate
# #1: NO C++ builder; the .ckir is the SOLE source). BINDING CONTRACT: TLAS@0 (REAL — traced), rays@1 (read, 6 f32/thread:
# origin.xyz + dir.xyz), hit_flag@2 (write, U32), hit_t@3 (write, F32). local_size=64 (size the ray/flag/t buffers to a
# workgroup multiple so no tail thread reads/writes out of bounds — the stage-1 rt_witness no-guard convention).
schema = 1

