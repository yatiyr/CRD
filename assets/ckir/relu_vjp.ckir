# relu_vjp.ckir - the elementwise ReLU vector-Jacobian-product (the MLP-backward activation grad): dx[gid] = (x[gid] > 0) ? dy[gid]
# : 0, i.e. the relu forward mask applied to the incoming adjoint. 3 buffers: x@0 (read, the FORWARD pre-activation z) . dy@1 (read,
# the incoming adjoint) . dx@2 (write, the outgoing adjoint) — access "r,r,w". One thread per element, gid = LocalInvocationIndex in
# [0, numel). ⛔ CEIR-26d-4: local_size is the SENTINEL [0,1,1] = "bind x from the write operand's numel at cook" (the relu.ckir
# 26d-2b mechanism, mirrored) — the VizDispatch resolver cook-binds it via bind_authored_local_size(local_size, dx-numel, kMax)
# before emit; an UNBOUND 0 reaching emit is a resolver error, NEVER silently 1. This retires the grad.cpp M·hidden==32 baked-shape
# reject (26d-4b), so a vjp of an MLP at ANY interior width ≤ the single-workgroup cap runs. Node refs POSITIONAL; F32 default;
# LocalInvocationIndex = KBuiltin 4. ⛔ GENERATED by build_relu_vjp (test_ckir_asset.cpp) via ckir_write — REGEN with
# `crd-kir-tests.exe "[.emit-relu-vjp]"` then RE-ADD this header (ckir_write emits a generic one); the builder MUST set local_size=0.
schema = 1

[[entry]]
stage = "Compute"
inputs = 0
position = -1
frag_depth = -1
discard_cond = -1
early_fragment_tests = false
depth_mode = "Any"
shading_rate = -1
storage_write_index = -1
storage_write_value = -1
interlock = false
n_out = 0
local_size = [0, 1, 1]
kernel_body_begin = 0
kernel_body_count = 1
mesh_vertices = 0
mesh_primitives = 0
mesh_prim = -1
task_emit = -1
task_payload = [-1, -1, -1, -1]
n_task_payload = 0
tess_patch_size = 0
tess_inner = -1
tess_outer = -1
mesh_payload_in = false
storage_read_only = false

[[node]]
id = "n0"
op = "BufferDecl"
shape = [1]

[[node]]
id = "n1"
op = "BufferDecl"
shape = [1]
iidx = 1

[[node]]
id = "n2"
op = "BufferDecl"
shape = [1]
iidx = 2
axes = 1

[[node]]
id = "n3"
op = "Builtin"
dtype = "U32"
shape = [1]
iidx = 4

[[node]]
id = "n4"
op = "Const"
shape = [1]

[[node]]
id = "n5"
op = "BufferLoad"
shape = [1]
in = ["n0", "n3"]

[[node]]
id = "n6"
op = "BufferLoad"
shape = [1]
in = ["n1", "n3"]

[[node]]
id = "n7"
op = "CmpGt"
dtype = "Bool"
shape = [1]
in = ["n5", "n4"]

[[node]]
id = "n8"
op = "Select"
shape = [1]
in = ["n6", "n4", "n7"]

[[stmt]]
kind = "BufferStore"
target = "n2"
index = "n3"
value = "n8"
