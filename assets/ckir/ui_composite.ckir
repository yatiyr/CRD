# .ckir - an authored CKIR program (node graph). A node editor reads this and turns it into CKIR.
# CEIR-31b-3-b UI-EFFECT COMPOSITE (the S141 frosted-glass chain's LAST pass: lerp the blurred effect over the scene by a
# panel-quad coverage mask). mask=0 -> scene, mask=1 -> effect: out.rgb = mix(scene.rgb, effect.rgb, mask.r); out.a = 1.
# MULTI-TEXTURE fullscreen via the BINDLESS idiom (the deferred_lighting.ckir precedent, device-proven both backends): ONE
# descriptor-array Texture at the bindless heap (set 0, binding 16, count 3) + ONE Sampler (binding 2, the ui-kernel-family
# slot shared with ui_blur) + three SampleIndexed(tex, samp, uv, layer) at layers 0/1/2. The frame graph binds a fullscreen
# pass's reads=[...] into the heap in DECLARATION ORDER (the multi-read fullscreen contract; a 1-read pass would bind a
# single texture at binding 1, NOT the heap) -> the 31b-3-c ui_frosted_glass.frame.toml MUST declare reads = [scene, effect,
# mask] in THAT order, and its mask pass MUST write coverage to the RED channel (mask.r; a solid vec4(1,1,1,1) quad into a
# transient the frame CLEARS to 0, so outside-the-quad reads 0). Binding/layer correctness is provable only ON-DEVICE (31b-4 arm (a): far-from-edge ==
# tint(A/B) fails visibly if a layer or channel is wrong). 0 spec-consts (a pure Mix); a spec_N on the composite pass FAILS
# SpecConstNotInProgram at the seat, never the kernel. Hand-authored straight-line text; the reading gate is structural.
schema = 1

[[entry]]
stage = "Fragment"
inputs = 0
position = -1
frag_depth = -1
discard_cond = -1
early_fragment_tests = false
depth_mode = "Any"
