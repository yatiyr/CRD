id = "n34"
op = "Cast"
shape = [1]
in = ["n33"]
# sign = byte >> 7
[[node]]
id = "n35"
op = "Shr"
dtype = "U32"
shape = [1]
in = ["n33", "n12"]
# f32(sign)
[[node]]
id = "n36"
op = "Cast"
shape = [1]
in = ["n35"]
# fold = 256 * sign
[[node]]
id = "n37"
op = "Mul"
shape = [1]
in = ["n21", "n36"]
# signed = f32(byte) - fold
[[node]]
id = "n38"
op = "Sub"
shape = [1]
in = ["n34", "n37"]
# prod = a * signed
[[node]]
id = "n39"
op = "Mul"
shape = [1]
in = ["n26", "n38"]

