# quant_gemm_q8.ckir - CEIR-23b-2c the FUSED symmetric per-tensor dequantize->gemm kernel (the StageKind::QuantGemm collapse).
#   D[m,n] = scale[0] * sum_{k=0..K-1} A[m,k] * int8(W_q8[k,n])          (per-tensor symmetric: zero_point == 0, dropped)
# Fixed dims M=4, K=8, N=8 (K*N=64 -> the UNFUSED reference leg reuses quant_dequantize_q8_sym.ckir as-is at [64]). The dequant's
# f32 weight is NEVER materialized: the int8 weight is sign-extended INLINE inside the k-accumulation (the §54 fusion win). Same
# u32-packed int8 storage + FLOAT sign-extend as 23b-1 (logical Shr/BitAnd + Cast; NO arithmetic-Shr, NO BitfieldExtract). 4
# buffers positional: A@0 (f32 [M*K]) . W_q8@1 (u32-packed int8 [K*N]) . scale@2 (f32 [1]) . D@3 (f32 [M*N], write). One workgroup
# of M*N=32 threads; gid = LocalInvocationIndex; m = gid>>3, n = gid&7 (N=8); base = m*8 (== m*K == m*N since K==N==8). Node refs
# POSITIONAL ("n<idx>"; the id is ignored). k-loop is STRAIGHT-LINE UNROLLED (no stmt_for — the 23d runtime-bound prereq).
schema = 1

[[entry]]
stage = "Compute"
inputs = 0
position = -1
frag_depth = -1
discard_cond = -1
early_fragment_tests = false
depth_mode = "Any"
shading_rate = -1
storage_write_index = -1
storage_write_value = -1
interlock = false
n_out = 0
local_size = [32, 1, 1]
kernel_body_begin = 0
kernel_body_count = 1
mesh_vertices = 0
mesh_primitives = 0
mesh_prim = -1
task_emit = -1
task_payload = [-1, -1, -1, -1]
n_task_payload = 0
tess_patch_size = 0
tess_inner = -1
tess_outer = -1
mesh_payload_in = false
storage_read_only = false

# --- buffers (n0..n3) ---
# A@0 (f32 activations [M*K], read)
[[node]]
id = "n0"
op = "BufferDecl"
shape = [1]
axes = 1

# W_q8@1 (u32-packed int8 weights [K*N], read)
[[node]]
id = "n1"
op = "BufferDecl"
dtype = "U32"
shape = [1]
iidx = 1
axes = 1

# scale@2 (f32 [1], read)
[[node]]
id = "n2"
op = "BufferDecl"
shape = [1]
iidx = 2
axes = 1

# D@3 (f32 output [M*N], write)
[[node]]
id = "n3"
op = "BufferDecl"
shape = [1]
iidx = 3
axes = 1

# --- gid + constants (n4..n21) ---
# gid = gl_LocalInvocationIndex (KBuiltin 4; scalar uint)
[[node]]
id = "n4"
op = "Builtin"
dtype = "U32"
shape = [1]
iidx = 4

# const u32 0
[[node]]
id = "n5"
op = "Const"
dtype = "U32"
shape = [1]

