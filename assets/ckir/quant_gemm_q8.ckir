id = "n22"
op = "Shr"
dtype = "U32"
shape = [1]
in = ["n4", "n8"]

# n = gid & 7
[[node]]
id = "n23"
op = "BitAnd"
dtype = "U32"
shape = [1]
in = ["n4", "n12"]

# base = m * 8  (== m*K == m*N, K==N==8)
