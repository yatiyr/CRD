# .ckir - an authored CKIR program (node graph). A node editor reads this and turns it into CKIR.
# ⛔⛔ CEIR-19b/19z-3 (F2) COMPOSITE: the flat-lit scene_hdr MULTIPLIED by the ray-traced shadow mask → @output. The RT
# shadow term is now VISIBLE (shadowed pixels darken). scene_hdr (input0 texture) is sampled at the fullscreen uv; the
# shadow mask is shadow_mask_buf, bound to the fullscreen `constants` slot (map_raster routes a StorageBuffer read there;
# frame_runtime binds fs_constants) and read per-pixel via StorageLoad — the taa_resolve precedent. The mask is a flat
# f32 array indexed py*W+px (the SAME layout the RT pass wrote, matching worldpos_buf's GlobalInvocationId flat index):
#   px,py = floor(FragCoord.xy)   (FragCoord = builtin 11, vec4; Cast→U32 truncates the +0.5 pixel centre)
#   W     = TexSize(scene_hdr).x  (self-contained — no rt_constants/header word; the fullscreen pass has ONE buffer slot,
#           already taken by shadow_mask_buf, so W comes from the colour texture's own size query)
#   mask  = intBitsToFloat(shadow_mask_buf[py*W+px])   (0 = SHADOWED, 1 = LIT)
#   @output = scene_hdr * mask
schema = 1

[[entry]]
stage = "Fragment"
inputs = 0
position = -1
frag_depth = -1
discard_cond = -1
early_fragment_tests = false
depth_mode = "Any"
shading_rate = -1
storage_write_index = -1
storage_write_value = -1
interlock = false
n_out = 1
local_size = [1, 1, 1]
kernel_body_begin = -1
kernel_body_count = 0
mesh_vertices = 0
mesh_primitives = 0
mesh_prim = -1
task_emit = -1
task_payload = [-1, -1, -1, -1]
n_task_payload = 0
tess_patch_size = 0
tess_inner = -1
tess_outer = -1
mesh_payload_in = false
storage_read_only = false

[[out]]
node = "n19"
location = 0
interp = "Smooth"

