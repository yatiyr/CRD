# .ckir - an authored CKIR program (node graph). A node editor reads this and turns it into CKIR.
# CEIR-31b-1a-iii UI-EFFECT TINT + NOISE (the §141 frosted-glass chain's grain pass). A fullscreen fragment pass that
# samples the (blurred) backdrop, multiplies by a per-channel TINT, and adds a per-pixel film GRAIN:
#   @output = TexSample(backdrop) * tint + splat(noise(FragCoord) * amp)
# tint = 4 SCALAR spec-consts (constant_id 0..3, r/g/b/a) assembled via Vec2/VecConcat -> vec4 (NOT baked: 31b-4 arm (a)
#   sets a known tint; one asset must serve every tint color). amp = spec-const 4 (default 0.03); 31b-4 sets amp=0 for the
#   far-from-edge +/-1LSB arm (a) and amp>0 for the grain-variance arm (e).
# noise = a backend-EXACT integer hash of the pixel coord (NOT sin-hash, which is precision-garbage + backend-divergent):
#   x,y = (u32)FragCoord.xy;  h = x*0x9E3779B1 ^ y*0x85EBCA77;  h ^= h>>15;  h *= 0x27D4EB2F;  h ^= h>>13;
#   noise = (f32)h * (1/2^32)   [in [0,1); Cast<F32> is a value convert, NOT IntBitsToFloat/reinterpret]
#   -- all hash nodes are dtype=U32 so the emitter lowers to unsigned uint `>>` (logical shift, not arithmetic), and the
#   oracle wraps Mul mod 2^32 (the u32-wrap scar) -- so CPU-eval == GPU bit-for-bit.
# ⛔ device-free gate this tick is STRUCTURAL (eval_cpu_kernel refuses Vec4 -- [[scars_ckir_emitter_eval]]): parse + byte-
# exact roundtrip + op-vocab teeth (1 TexSample, 5 spec-consts, BitXor>=2, Shr>=2, 0 StorageLoad, emits texture( + >>).
# The hash MATH is proven at 31b-1a-iii part 2 (NEXT tick): a SEPARATE scalar-output oracle (build_hash_scalar, eval_cpu_
# kernel-verified vs a C++ reference) + a NODE-SEQUENCE match proving THIS committed file embeds that same hash. Device
# numerics at 31b-4 arm (e). Texture/Sampler binding (iidx 1/2, StageIn uv) lifted from rt_composite's proven n0-n3.
schema = 1

[[entry]]
stage = "Fragment"
inputs = 0
position = -1
frag_depth = -1
discard_cond = -1
early_fragment_tests = false
depth_mode = "Any"
shading_rate = -1
storage_write_index = -1
storage_write_value = -1
interlock = false
n_out = 1
local_size = [1, 1, 1]
kernel_body_begin = -1
kernel_body_count = 0
mesh_vertices = 0
mesh_primitives = 0
mesh_prim = -1
task_emit = -1
task_payload = [-1, -1, -1, -1]
n_task_payload = 0
tess_patch_size = 0
tess_inner = -1
tess_outer = -1
mesh_payload_in = false
storage_read_only = false

[[out]]
node = "n36"
location = 0
interp = "Smooth"

# --- backdrop sample -----------------------------------------------------------
[[node]]
id = "n0"
op = "StageIn"
tkind = "Vec"
trows = 2
shape = [1]

[[node]]
