tcols = 0
shape = [1]
iidx = 2

[[node]]
id = "n3"
op = "TexSample"
tkind = "Vec"
trows = 4
shape = [1]
in = ["n1", "n2", "n0"]

# --- tint = 4 scalar spec-consts (constant_id 0..3) -> vec4 --------------------
[[node]]
