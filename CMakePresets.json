{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CRD_BUILD_TESTS": "ON",
                "CRD_SIMD_LEVEL": "auto",
                "CRD_DETERMINISTIC_FP": "ON"
            }
        },
        {
            "name": "win-base",
            "hidden": true,
            "inherits": "base",
            "generator": "Ninja",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [
                        "Windows"
                    ],
                    "intelliSenseMode": "windows-msvc-x64"
                }
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "generator": "Ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [
                        "Linux"
                    ],
                    "intelliSenseMode": "linux-gcc-x64"
                },
                "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
                    "copySourcesOptions": {
                        "exclusionList": [
                            ".vs",
                            ".git",
                            "out",
                            "build",
                            "external",
                            ".cpm-cache",
                            ".venv",
                            "__pycache__"
                        ]
                    }
                }
            }
        },
        {
            "name": "win-debug",
            "displayName": "Windows Debug",
            "inherits": "win-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CRD_ENABLE_ASSERTS": "ON",
                "CRD_ENABLE_PROFILING": "ON"
            }
        },
        {
            "name": "win-vs",
            "displayName": "Visual Studio 2026 x64 — all MSVC configurations (CMake 4.2+)",
            "inherits": "win-base",
            "generator": "Visual Studio 18 2026",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "set"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": null,
                "CMAKE_CXX_COMPILER": null,
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo;ASan;Shipping;ShippingProfile;DebugScalar;DebugSSE2",
                "CRD_PROJECT_SYNC": "ON",
                "CRD_NATIVE_PROFILES": "ON"
            },
            "binaryDir": "${sourceDir}/build/win-vs-debug"
        },
        {
            "name": "win-vs-debug",
            "hidden": true,
            "inherits": "win-vs",
            "description": "Inheritance compatibility only; configure via win-vs. project-sync accepts the legacy name."
        },
        {
            "name": "win-release",
            "displayName": "Windows Release",
            "inherits": "win-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
                "CRD_ENABLE_ASSERTS": "OFF",
                "CRD_ENABLE_PROFILING": "OFF"
            }
        },
        {
            "name": "win-relwithdebinfo",
            "displayName": "Windows RelWithDebInfo",
            "inherits": "win-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
                "CRD_ENABLE_ASSERTS": "ON",
                "CRD_ENABLE_PROFILING": "ON"
            }
        },
        {
            "name": "win-asan",
            "displayName": "Windows Debug + ASan",
            "inherits": "win-debug",
            "cacheVariables": {
                "CRD_ENABLE_ASAN": "ON"
            }
        },
        {
            "name": "win-tidy",
            "displayName": "Windows Debug + clang-tidy",
            "inherits": "win-debug",
            "cacheVariables": {
                "CRD_ENABLE_CLANG_TIDY": "ON"
            }
        },
        {
            "name": "win-tidy-local",
            "displayName": "Windows + clang-tidy diagnostic preview (non-gating; CI uses strict win-tidy)",
            "inherits": "win-tidy",
            "cacheVariables": {
                "CRD_CLANG_TIDY_WARNINGS_AS_ERRORS": "OFF"
            }
        },
        {
            "name": "win-clang-cl",
            "displayName": "Windows Debug + clang-cl",
            "inherits": "win-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CRD_ENABLE_ASSERTS": "ON",
                "CRD_ENABLE_PROFILING": "ON"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "intelliSenseMode": "windows-clang-x64"
                }
            }
        },
        {
            "name": "win-shipping",
            "displayName": "Windows MSVC Shipping (max opts + PDB; tests + sandbox enabled)",
            "inherits": "win-release",
            "cacheVariables": {
                "CRD_BUILD_TESTS": "ON",
                "CRD_BUILD_BENCHMARKS": "OFF",
                "CRD_SHIPPING": "ON"
            }
        },
        {
            "name": "win-clang-cl-shipping",
            "displayName": "Windows clang-cl Shipping (max opts + thin-LTO + PDB; tests + sandbox enabled)",
            "inherits": "win-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
                "CRD_ENABLE_ASSERTS": "OFF",
                "CRD_ENABLE_PROFILING": "OFF",
                "CRD_BUILD_TESTS": "ON",
                "CRD_BUILD_BENCHMARKS": "OFF",
                "CRD_SHIPPING": "ON",
                "_NOTE_lto_isolation": "engine/assets/resources/CMakeLists.txt isolates crdr.cpp from clang-cl thin-LTO (single-file -fno-lto, mirrors crd-jobs worker_pool.cpp/Od pattern); rest of shipping module gets full LTO"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "intelliSenseMode": "windows-clang-x64"
                }
            }
        },
        {
            "name": "win-shipping-profile",
            "displayName": "Windows MSVC Shipping + Profiling (max opts + LTCG + PDB + crd-perf compiled in)",
            "inherits": "win-shipping",
            "cacheVariables": {
                "CRD_ENABLE_PROFILING": "ON",
                "_NOTE_crd_perf_under_ltcg": "Validates crd-perf substrate under MSVC shipping LTCG + /OPT:ICF + /O2. Catches LTCG-class bugs in profiler hot paths (atomic stores, CAS-loops, thread-local indirection). Per-slice DoD config #4 added 2026-05-15 in D-003 v0b post-discussion. Runtime is still gated on Profiler::init() -- a 'ship with profiler compiled in, players pay nothing until init()' binary uses this preset."
            }
        },
        {
            "name": "win-debug-scalar",
            "displayName": "Windows Debug + force scalar SIMD (parity check)",
            "inherits": "win-debug",
            "cacheVariables": {
                "CRD_SIMD_LEVEL": "scalar"
            }
        },
        {
