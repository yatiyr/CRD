#version 450

// Phase 3.1.7.6 v0c — second-pass shader for the barrier discriminator
// test. Reads `u_input.data[i]`, writes `2 * u_input.data[i]` to
// `u_output.data[i]`. Paired with `compute_v0b_dispatch.comp` (first
// pass writes `i + kBaseOffset`), validated end-to-end:
//
//   pass 1 (v0b shader): bufA[i] = i + kBaseOffset
//   buffer_barrier(bufA, ComputeShaderWrite → ComputeShaderRead)
//   pass 2 (this shader):  bufB[i] = 2 * bufA[i] = 2 * (i + kBaseOffset)
//   host readback: bufB[i] == 2 * (i + kBaseOffset)
//
// Without the barrier, validation layer fires VUID on the bufA hazard
// (write-after-write in compute is undefined without synchronization).

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Input
{
    uint data[];
} u_input;

layout(set = 0, binding = 1) writeonly buffer Output
{
    uint data[];
} u_output;

void main()
{
    u_output.data[gl_GlobalInvocationID.x] = 2u * u_input.data[gl_GlobalInvocationID.x];
}
