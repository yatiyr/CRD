 "exclusions": [
  {"outcome": "ResultVerdict", "value": "Agrees", "class": "default-value",
   "reason": "ResultCheck::verdict's initializer in result_oracle.hpp; a run whose results all agree keeps it."},
  {"outcome": "ImportReject", "value": "None", "class": "default-value",
   "reason": "BundleImport::reject's initializer in bundle_import.hpp; an accepted import keeps it."},
  {"outcome": "HostLoad", "value": "Ok", "class": "default-value",
   "reason": "HostLoadResult::status's initializer in inspect_host.hpp; a successful load keeps it."},
  {"outcome": "DivergenceKind", "value": "None", "class": "default-value",
   "reason": "Divergence::kind's initializer in replay_record.hpp; an agreeing replay keeps it."},
  {"outcome": "DeviceDivergenceKind", "value": "None", "class": "default-value",
   "reason": "DeviceDivergence::kind's initializer in device_replay.hpp; an agreeing replay keeps it."},
  {"outcome": "specimen Verdict", "value": "MissingSymbolizer", "class": "no-producer",
   "reason": "Declared since DIAG.0 but the harness never returns it: no case checks for a symbolizer. A dead outcome, owned until a symbolizer check exists."},
  {"outcome": "FlightPolicyStatus", "value": "RejectedOutOfMemory", "class": "resource-failure", "reason": "new (std::nothrow) or the ring allocation must fail; the recorder takes no allocator a test could fail."},
  {"outcome": "DiagAssetRead", "value": "Failed", "class": "resource-failure", "reason": "std::ferror after fread; diag_assets.cpp reads with stdio and bypasses the I/O fault seam (queued follow-up), so no test can fail the read."},
  {"outcome": "FaultArmStatus", "value": "Unavailable", "class": "other-configuration", "reason": "Returned only where fault seams are not compiled (shipping lanes); crd-perf-tests asserts it on win-shipping and linux-gcc-shipping."},
  {"outcome": "InstallResult", "value": "OkReplacedForeignFilter", "class": "windows-only", "reason": "The unhandled-exception filter replacement exists only in the Win32 install path."},
  {"outcome": "InstallResult", "value": "PathTooLong", "class": "windows-only", "reason": "The wide-path length check exists only in the Win32 install path."},
  {"outcome": "InstallResult", "value": "FilterInstallFailed", "class": "resource-failure", "reason": "On Linux sigaction must fail for a valid signal and handler, which no test can force; the Win32 branch is not compiled here."},
  {"outcome": "InstallResult", "value": "Unsupported", "class": "other-configuration", "reason": "The stub for platforms that are neither Windows nor Linux."},
  {"outcome": "WriteResult", "value": "Ok", "class": "dying-child", "reason": "The Linux record is written inside the fault handler of a specimen that then dies by its signal, so no profile is written; the Win32 sites are not compiled here."},
  {"outcome": "WriteResult", "value": "OpenFailed", "class": "dying-child", "reason": "The Linux record's open runs inside the dying specimen's fault handler; the Win32 sites are not compiled here."},
  {"outcome": "WriteResult", "value": "DumpFailed", "class": "dying-child", "reason": "The Linux record's write and fsync run inside the dying specimen's fault handler; the Win32 site is not compiled here."},
  {"outcome": "WriteResult", "value": "Suppressed", "class": "dying-child", "reason": "The losing thread of two concurrent faults runs inside the dying specimen; the Win32 sites are not compiled here."},
  {"outcome": "WriteResult", "value": "NotInstalled", "class": "windows-only", "reason": "Only the Win32 on-demand dump path reports it."},
  {"outcome": "WriteResult", "value": "FlushFailed", "class": "windows-only", "reason": "Only the Win32 minidump file flush reports it."},
  {"outcome": "WriteResult", "value": "HandlerTimeout", "class": "windows-only", "reason": "Only the Win32 out-of-process dump wait reports it."},
  {"outcome": "specimen Verdict", "value": "SanitizerCaught", "class": "other-configuration", "reason": "Only a sanitizer lane builds specimens that print a sanitizer report; the seeded-fault runner checks it on win-asan, linux-gcc-asan and linux-clang-tsan."}
 ]
