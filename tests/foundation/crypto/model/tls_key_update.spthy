theory CeridTlsKeyUpdate
begin

/*
 * The traffic key epochs of a Cerid TLS 1.3 session after its handshake: records under the current key and the
 * KeyUpdate chain (decision S7). Checked in CI by scripts/check-protocol-model.py with the pinned Tamarin; every lemma
 * below is expected to verify.
 *
 * Design: docs/design/network-foundation.md#tls-sessions
 * Design: docs/design/network-foundation.md#protocol-model
 *
 * What is modelled:
 *   - One direction of a session (the other is the same chain over the other traffic secret). Its root is a
 *     traffic secret the handshake left secret: tls_handshake.spthy proves client_traffic_secret and
 *     server_traffic_secret, so this theory starts from a fresh shared secret instead of repeating the handshake.
 *   - The chain, unbounded: epoch %e's key is chain(root, %e), epoch 1 the traffic secret itself and epoch %e + 1
 *     RFC 8446 section 7.2's application_traffic_secret_N+1 = HKDF-Expand-Label(secret_N, "traffic upd"). chain is
 *     private, so the adversary holds no key it was not given, and its one computation over the chain is the one
 *     HKDF-Expand-Label allows (Advance): from a key it holds, the next one. Being one-way, nothing leads back.
 *   - The sender protects records under its current key; a KeyUpdate, itself protected under the current key,
 *     moves both ends to the next key.
 *   - The record layer over a reliable stream: each record carries its sequence number within the epoch, which a
 *     KeyUpdate resets (S7), and the receiver accepts only the next one; this is TLS's implicit AEAD nonce.
 *   - Either end's current key can be revealed at any time (a state compromise); an end's state holds the root only
 *     as the model's index of its chain, and a reveal outputs the current key alone.
 * Proven for chains of any length: key updates are forward secure (a key leaks only if it or an earlier key of its
 * chain was revealed); records and KeyUpdates are accepted only as sent, at their epoch and sequence number, unless
 * that key or an earlier one was revealed; and, as the bound of the guarantee, an update does not heal a compromise
 * (no post-compromise security). Each session is named by its fresh root. That a record is accepted at most once is
 * not proven here (the receiver's linear state, revealed in place, leaves Tamarin no induction over its position);
 * test_tls.cpp's adversarial-bytes test holds it (a replayed, reordered or earlier-key record fails).
 */

builtins: symmetric-encryption, natural-numbers

functions: chain/2 [private]

// The root: a traffic secret only the two ends hold (the handshake model's traffic secret lemmas).
rule Establish:
    [ Fr(~root) ]
  --[ Established(~root) ]->
    [ Sender(~root, %1, %1), Receiver(~root, %1, %1) ]

rule SendRecord:
    [ Sender(root, %e, %n), Fr(~m) ]
  --[ Sent(root, %e, %n, ~m) ]->
    [ Sender(root, %e, %n %+ %1), Out(senc(<'record', %n, ~m>, chain(root, %e))) ]

// The KeyUpdate is the last record under the old key; the sender's next record is the new key's first.
rule SendUpdate:
    [ Sender(root, %e, %n) ]
  --[ SentUpdate(root, %e, %n) ]->
    [ Sender(root, %e %+ %1, %1), Out(senc(<'key_update', %n>, chain(root, %e))) ]

// The receiver computes its key from its state; the derivation check, which sees chain as the adversary does
// (private), cannot, so it is off for this rule alone.
rule ReceiveRecord [no_derivcheck]:
    [ Receiver(root, %e, %n), In(senc(<'record', %n, m>, chain(root, %e))) ]
  --[ Accepted(root, %e, %n, m) ]->
    [ Receiver(root, %e, %n %+ %1) ]

rule ReceiveUpdate:
    [ Receiver(root, %e, %n), In(senc(<'key_update', %n>, chain(root, %e))) ]
  --[ ReceivedUpdate(root, %e, %n) ]->
    [ Receiver(root, %e %+ %1, %1) ]

// A state compromise reveals the current key of either end.
rule RevealSender:
    [ Sender(root, %e, %n) ] --[ Reveal(root, %e) ]-> [ Sender(root, %e, %n), Out(chain(root, %e)) ]

rule RevealReceiver:
    [ Receiver(root, %e, %n) ] --[ Reveal(root, %e) ]-> [ Receiver(root, %e, %n), Out(chain(root, %e)) ]

// HKDF-Expand-Label over a key the adversary holds: the next key of its chain. It learns neither the root nor the
// epoch from the key (the derivation check's complaint is the point).
rule Advance [no_derivcheck]:
    [ In(chain(root, %e)) ] --[ Advanced(root, %e) ]-> [ Out(chain(root, %e %+ %1)) ]

// Two updates, then a record accepted under the third key, with no key revealed.
lemma updates_complete:
  exists-trace
    "Ex root m #e #a. Established(root) @ #e & Accepted(root, %1 %+ %1 %+ %1, %1, m) @ #a
      & not (Ex r %d #v. Reveal(r, %d) @ #v)"

// Forward security of the updates, over the whole chain: a key is known only if that key or an earlier one of its
// chain was revealed, so a compromise exposes no key the session used before it.
lemma key_secrecy [use_induction, reuse]:
    "All root %e #j. K(chain(root, %e)) @ #j ==> Ex %d #v. Reveal(root, %d) @ #v & (%d = %e | %d << %e)"

// Records are accepted only as the sender sent them, at their epoch and sequence number, unless their key or an
// earlier one of its chain was revealed.
lemma record_authentic:
    "All root %e %n m #a. Accepted(root, %e, %n, m) @ #a ==>
        (Ex #s. Sent(root, %e, %n, m) @ #s & #s < #a) | (Ex %d #v. Reveal(root, %d) @ #v & (%d = %e | %d << %e))"

// Only the sender moves the receiver to the next key, unless the current key or an earlier one was revealed.
lemma update_authentic:
    "All root %e %n #i. ReceivedUpdate(root, %e, %n) @ #i ==>
        (Ex #s. SentUpdate(root, %e, %n) @ #s & #s < #i)
        | (Ex %d #v. Reveal(root, %d) @ #v & (%d = %e | %d << %e))"

// The bound: a key revealed in one epoch gives the adversary the next epoch's key (no post-compromise security).
lemma update_does_not_heal:
  exists-trace
    "Ex root %e #v #j. Reveal(root, %e) @ #v & K(chain(root, %e %+ %1)) @ #j"

end
