<?xml version="1.0" encoding="utf-8"?>
<!-- crd-crypto tests: the instrumentation APK that runs the Android Keystore's key store case in an application
     process (NET.2, decision K15; scripts/android-apk.py builds it, scripts/android-device.py instrument runs it).
     It instruments itself: no activity, no permission, debuggable so that run-as reads its report. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="cerid.test.keystore">
    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="31" />
    <application android:label="Cerid Keystore tests" android:debuggable="true" android:extractNativeLibs="true"
                 android:hasCode="true" />
    <instrumentation android:name=".KeyStoreRunner" android:targetPackage="cerid.test.keystore"
                     android:label="Cerid Keystore tests" />
</manifest>
